# Copy this file to apps/admin/.env (or .env.local) and fill in real values.
# Never commit .env/.env.local (already gitignored) — only .env.example,
# which holds no real secrets, ever gets committed.
#
# IMPORTANT: this file must live in apps/admin/ (not the repo root) — Next.js
# only loads .env files from the directory next.config.ts is in, so a .env
# at the repo root is silently ignored when running `pnpm dev:admin`.

# ── Supabase ────────────────────────────────────────────────────────────
# Local dev (after `npx supabase start` — see README.md "Database setup"):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   (the CLI prints this value labeled "anon key" — it's the same kind of
#   key a hosted project calls the publishable key; use it here either way)
#
# Hosted Supabase project: Settings → API in the Supabase dashboard, under
# "Publishable key". Safe to ship in the browser bundle — Row Level
# Security policies are what actually restrict access, not keeping this
# key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role / secret key: full database access, bypasses RLS entirely.
# Server-side only — NEVER prefix this with NEXT_PUBLIC_, and never ship it
# inside the app. Used by lib/supabase/admin.ts, imported only from
# "use server" files, for the one operation that structurally requires it:
# creating a real auth.users account for a walk-in customer during manual
# booking creation (see (dashboard)/bookings/actions.ts createCustomerAction).
SUPABASE_SERVICE_ROLE_KEY=

# Company-wide "scan to join" QR code token. Server-side only. Generate a
# long random value once (e.g. `openssl rand -hex 32`) and set the same
# value here and wherever the QR code is printed/displayed — the admin
# "QR Code" page (app/(dashboard)/join-qr) reads this to render it, and the
# public app/join/[token] route checks the URL's token against it. Rotate
# by changing this value and reprinting the QR code if a link ever leaks.
QR_JOIN_TOKEN=

# Optional. The public origin (scheme + host, no trailing slash, no path)
# the QR code's link is built from. Server-side only. Without this set, the
# QR page falls back to the Host/X-Forwarded-Proto headers of the request
# that loaded IT — which is wrong whenever that's not the same address a
# customer's phone can reach, e.g.:
#   - Local LAN testing: you open the admin app at http://localhost:3000 on
#     your laptop, so the QR would encode "localhost" — a phone on the same
#     Wi-Fi can't resolve that to your laptop. Set this to your laptop's LAN
#     address instead, e.g.:
#       JOIN_BASE_URL=http://192.168.8.26:3000
#   - Production behind infra that doesn't forward the real public host.
#     Set this to your real public URL, e.g.:
#       JOIN_BASE_URL=https://admin.yourdomain.com
JOIN_BASE_URL=

