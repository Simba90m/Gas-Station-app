# Copy this file to apps/mobile/.env and fill in real values.
# Never commit .env/.env.local (already gitignored) — only .env.example,
# which holds no real secrets, ever gets committed.
#
# Expo only inlines EXPO_PUBLIC_* vars into the app bundle — see
# apps/mobile/src/lib/env.ts.

# ── Supabase ────────────────────────────────────────────────────────────
# Local dev (after `npx supabase start` — see README.md "Database setup"):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   (the CLI prints this value labeled "anon key" — it's the same kind of
#   key a hosted project calls the publishable key; use it here either way)
#
# Hosted Supabase project: Settings → API in the Supabase dashboard, under
# "Publishable key". Safe to ship in the app bundle — Row Level Security
# policies are what actually restrict access, not keeping this key secret.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
