# Copy this file to .env and fill in real values.
# Never commit .env (it's already in .gitignore) — only .env.example, which
# holds no real secrets, ever gets committed.
#
# Neither app calls Supabase yet (no screens use it until Phase 3/4), so
# nothing here is strictly required to run the apps today. Fill in the
# Supabase values now if you've run `npx supabase start` (see README.md)
# and want the apps ready to connect once Phase 3 adds real screens.

# ── Supabase (apps/admin and apps/mobile both use these) ──────────────────
# Local dev (after `npx supabase start` — see README.md "Database setup"):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   (anon key is printed by `supabase start` / `supabase status`)
#
# Hosted project: Settings → API in the Supabase dashboard. The "anon" key
# is safe to ship in an app — Row Level Security policies are what actually
# restrict access, not keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: full database access, bypasses RLS entirely.
# Server-side only (e.g. an admin-only script) — NEVER prefix this with
# NEXT_PUBLIC_ or EXPO_PUBLIC_, and never ship it inside either app.
SUPABASE_SERVICE_ROLE_KEY=

# ── Maps (added when the customer app's station map screen is built) ──────
# Provider choice (Google Maps vs Mapbox) is not made yet — see
# docs/ARCHITECTURE.md. Whichever is chosen, its key goes here.
EXPO_PUBLIC_MAPS_API_KEY=

# ── Push notifications (added in Phase 9) ──────────────────────────────────
EXPO_PUBLIC_PROJECT_ID=
