# Copy this file to .env and fill in real values.
# Never commit .env (it's already in .gitignore) — only .env.example, which
# holds no real secrets, ever gets committed.
#
# Nothing here is required to run Phase 1 (both apps run fine without a
# database connection yet). These are documented now so the shape is clear
# before Phase 2 wires them up.

# ── Supabase (apps/admin and apps/mobile both use these) ──────────────────
# Found in your Supabase project settings → API. The "anon" key is safe to
# ship in an app — RLS policies (Phase 2) are what actually restrict access,
# not keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: full database access, bypasses RLS entirely.
# Server-side only (e.g. an admin-only script) — NEVER prefix this with
# NEXT_PUBLIC_ or EXPO_PUBLIC_, and never ship it inside either app.
SUPABASE_SERVICE_ROLE_KEY=

# ── Maps (added when the customer app's station map screen is built) ──────
# Provider choice (Google Maps vs Mapbox) is not made yet — see
# docs/ARCHITECTURE.md. Whichever is chosen, its key goes here.
EXPO_PUBLIC_MAPS_API_KEY=

# ── Push notifications (added in Phase 9) ──────────────────────────────────
EXPO_PUBLIC_PROJECT_ID=
