# This file is a REFERENCE OVERVIEW of every environment variable used
# across the project — it is not loaded by either app directly. Both
# Next.js (apps/admin) and Expo (apps/mobile) only load .env files from
# their OWN directory, not the monorepo root, so copying this file here
# and filling it in would silently do nothing.
#
# To actually configure an app: apps/admin/.env.example is the real,
# loaded template for the admin dashboard (copy it to apps/admin/.env).
# apps/mobile doesn't call Supabase yet (Phase 4) — no per-app template
# needed there until it does.

# ── Supabase — see apps/admin/.env.example for the authoritative version ──
# Local dev (after `npx supabase start` — see README.md "Database setup"):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   (the CLI prints this value labeled "anon key" — it's the same kind of
#   key a hosted project calls the publishable key)
#
# Hosted project: Settings → API in the Supabase dashboard, under
# "Publishable key". Safe to ship in an app — Row Level Security policies
# are what actually restrict access, not keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: full database access, bypasses RLS entirely.
# Server-side only (e.g. an admin-only script) — NEVER prefix this with
# NEXT_PUBLIC_ or EXPO_PUBLIC_, and never ship it inside either app.
SUPABASE_SERVICE_ROLE_KEY=

# ── Maps (added when the customer app's station map screen is built) ──────
# Provider choice (Google Maps vs Mapbox) is not made yet — see
# docs/ARCHITECTURE.md. Whichever is chosen, its key goes here.
EXPO_PUBLIC_MAPS_API_KEY=

# ── Push notifications (added in Phase 9) ──────────────────────────────────
EXPO_PUBLIC_PROJECT_ID=
