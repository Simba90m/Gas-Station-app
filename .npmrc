# node-linker=hoisted: use a single flat node_modules (like classic npm/
# Yarn) instead of pnpm's default "isolated" layout, which links every
# package through a deep, content-addressable .pnpm store using symlinks
# (e.g. apps/admin/node_modules/zod -> ../../../node_modules/.pnpm/zod@4.6.5/...).
#
# Added after two separate incidents where dependencies that were
# correctly declared (present in package.json, correctly resolved in
# pnpm-lock.yaml, confirmed via `pnpm why`/`pnpm list`) still failed to
# resolve for `tsc` specifically on Windows — first vitest in
# packages/utils, then zod/@supabase/ssr in apps/admin. Different packages
# each time, both times fine on Linux — pointing at symlink/junction
# creation reliability on Windows in general, not anything specific to
# those packages. `hoisted` avoids the deep per-package symlink chain
# almost entirely for regular npm dependencies.
node-linker=hoisted

# Workspace packages (@gas-station/*) still link via workspace:* as normal.
